From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] ORBPlatformLoader: honour ORB_PLATFORM_LIB

The platform library path was hard-coded to /usr/lib/libORBPlatformImpl.so. Allow the ORB_PLATFORM_LIB
environment variable to override it, so a test or self-contained deployment need not write to /usr/lib.

---
diff --git a/rdk/ORB/library/src/core/ORBPlatformLoader.cpp b/rdk/ORB/library/src/core/ORBPlatformLoader.cpp
index 2fa0540..819481a 100644
--- a/rdk/ORB/library/src/core/ORBPlatformLoader.cpp
+++ b/rdk/ORB/library/src/core/ORBPlatformLoader.cpp
@@ -18,8 +18,17 @@
 #include "ORBLogging.h"
 #include <dlfcn.h>
 
+#include <cstdlib>
+
 #define ORB_PLATFORM_IMPL_LIBRARY_NAME "/usr/lib/libORBPlatformImpl.so"
 
+// Let the environment point at the platform library, so it does not have to live in /usr/lib.
+static const char *OrbPlatformLibraryName()
+{
+    const char *path = getenv("ORB_PLATFORM_LIB");
+    return (path && *path) ? path : ORB_PLATFORM_IMPL_LIBRARY_NAME;
+}
+
 namespace orb {
 /**
  * Constructor.
@@ -48,7 +57,7 @@ ORBPlatform * ORBPlatformLoader::Load()
     char *errorMsg = nullptr;
 
     dlerror();
-    m_lib = dlopen(ORB_PLATFORM_IMPL_LIBRARY_NAME, RTLD_LAZY);
+    m_lib = dlopen(OrbPlatformLibraryName(), RTLD_LAZY);
     if (NULL == m_lib)
     {
         errorMsg = dlerror();
