From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] avcontrol: removeAttribute('data') used undeclared variables

removeAttribute('data') referenced 'priv' and 'value', which are not declared in that function, so it always threw a
ReferenceError. Applications that remove the data attribute while resetting the player (ZDFmediathek) then failed with their
generic media error (666) when starting the next video.

---
diff --git a/src/objects/avcontrol.js b/src/objects/avcontrol.js
index e6558dd..afafca4 100644
--- a/src/objects/avcontrol.js
+++ b/src/objects/avcontrol.js
@@ -163,11 +163,12 @@ hbbtv.objects.AVControl = (function() {
 
     prototype.removeAttribute = function(name) {
         if (name === 'data') {
-            delete privates.get(this).data;
+            const priv = privates.get(this);
             if (priv.playState !== PLAY_STATE_STOPPED) {
                 this.stop();
             }
-            if (value !== this.data) {
+            if (priv.data !== undefined) {
+                delete priv.data;
                 priv.seekPos = undefined;
                 priv.connected = false;
                 setMediaSettings.call(this, priv.MediaSettingsConfiguration);
