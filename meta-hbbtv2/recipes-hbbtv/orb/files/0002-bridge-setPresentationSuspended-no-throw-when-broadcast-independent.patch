From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] bridge: setPresentationSuspended is a no-op for a broadcast-independent application

ORB answers Broadcast.setPresentationSuspended with SecurityError for an application that was not launched from the
broadcast AIT, and the SecurityError escaped from A/V control stop(). Applications that stop a running preview before
starting the main video (ZDFmediathek) then failed with their generic media error.

---
diff --git a/src/bridge.js b/src/bridge.js
index df9a8d0..f6f0a68 100644
--- a/src/bridge.js
+++ b/src/bridge.js
@@ -583,9 +583,18 @@ hbbtv.bridge.broadcast = (function() {
      * @memberof bridge.broadcast#
      */
     exported.setPresentationSuspended = function(presentationSuspended) {
-        hbbtv.native.request('Broadcast.setPresentationSuspended', {
-            presentationSuspended: presentationSuspended,
-        });
+        try {
+            hbbtv.native.request('Broadcast.setPresentationSuspended', {
+                presentationSuspended: presentationSuspended,
+            });
+        } catch (e) {
+            // A broadcast-independent application has no broadcast presentation to suspend or resume: that is not an
+            // error for the caller. Letting the SecurityError escape broke A/V control stop() (and with it applications
+            // that stop a preview before starting the film, e.g. the ZDFmediathek: "MediaLibrary Error 666").
+            if (e.name !== 'SecurityError') {
+                throw e;
+            }
+        }
     };
 
     return exported;
