From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] application manager: start an application as broadcast-related without an AIT

An embedder that has the application URL and the current service but not the AIT (yet) could only start a
broadcast-independent application, whose Broadcast.* requests are refused with a SecurityError (the start
bars of ARD, RTL, ... then draw nothing). CreateBroadcastRelatedApplication() sets the current service and runs
the application with isBroadcast = true.

---
diff --git a/components/application_manager/application_manager.cpp b/components/application_manager/application_manager.cpp
index 5f8c062..989d7cf 100644
--- a/components/application_manager/application_manager.cpp
+++ b/components/application_manager/application_manager.cpp
@@ -203,6 +203,42 @@ bool ApplicationManager::CreateApplication(uint16_t callingAppId, const std::str
     return result;
 }
 
+/**
+ * Start an application from a URL as a broadcast-related application of the given service (see the header).
+ */
+bool ApplicationManager::CreateBroadcastRelatedApplication(const std::string &url,
+    uint16_t originalNetworkId, uint16_t transportStreamId, uint16_t serviceId)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_lock);
+
+    LOG(LOG_INFO, "CreateBroadcastRelatedApplication");
+    if (url.empty())
+    {
+        LOG(LOG_INFO, "Called with empty URL, early out");
+        m_sessionCallback->DispatchApplicationLoadErrorEvent();
+        return false;
+    }
+
+    m_previousService = m_currentService;
+    m_currentService = {
+        .originalNetworkId = originalNetworkId,
+        .transportStreamId = transportStreamId,
+        .serviceId = serviceId,
+    };
+    // there is no AIT to wait for (and none to time out): the application is the one that is given
+    m_currentServiceReceivedFirstAit = true;
+    m_currentServiceAitPid = 0;
+
+    App app = App::CreateAppFromUrl(url);
+    app.isBroadcast = true;
+    bool result = RunApp(app);
+    if (!result)
+    {
+        m_sessionCallback->DispatchApplicationLoadErrorEvent();
+    }
+    return result;
+}
+
 /**
  * Destroy the calling application.
  *
diff --git a/components/application_manager/application_manager.h b/components/application_manager/application_manager.h
index 0cf6c1a..78b72af 100644
--- a/components/application_manager/application_manager.h
+++ b/components/application_manager/application_manager.h
@@ -156,6 +156,21 @@ public:
      */
     bool CreateApplication(uint16_t callingAppId, const std::string &url);
 
+    /**
+     * Start an application from a URL as a BROADCAST-RELATED application of the given service, without an AIT: the embedder that
+     * hosts the engine does not have the AIT of the service (yet), only the application URL and the service. The application
+     * manager then acts as if the application had been started from the AIT of that service, in particular the Broadcast.*
+     * requests of the application are allowed (a broadcast-independent application gets a SecurityError for them).
+     *
+     * @param url                The entry page of the application
+     * @param originalNetworkId  The original network id of the current service
+     * @param transportStreamId  The transport stream id of the current service
+     * @param serviceId          The service id of the current service
+     * @return true if the application was started
+     */
+    bool CreateBroadcastRelatedApplication(const std::string &url, uint16_t originalNetworkId,
+        uint16_t transportStreamId, uint16_t serviceId);
+
     /**
      * Destroy the calling application.
      *
