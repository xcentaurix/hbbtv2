From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] Treat application/vnd.hbbtv.xhtml+xml as XHTML

HbbTV applications are commonly served as application/vnd.hbbtv.xhtml+xml. WebKit does not know the type: the
main resource is refused ("Frame load interrupted"), and it would not be parsed as XHTML anyway. Make it a
displayable non-image type and create an XHTML document for it.

---
diff --git a/Source/WebCore/dom/DOMImplementation.cpp b/Source/WebCore/dom/DOMImplementation.cpp
index ebe1389e..19e655bf 100644
--- a/Source/WebCore/dom/DOMImplementation.cpp
+++ b/Source/WebCore/dom/DOMImplementation.cpp
@@ -167,7 +167,7 @@ Ref<Document> DOMImplementation::createDocument(const String& contentType, Local
     // Plug-ins cannot take over for HTML, XHTML, plain text, or non-PDF images.
     if (equalLettersIgnoringASCIICase(contentType, "text/html"_s))
         return HTMLDocument::create(frame, settings, url, documentIdentifier);
-    if (equalLettersIgnoringASCIICase(contentType, "application/xhtml+xml"_s))
+    if (equalLettersIgnoringASCIICase(contentType, "application/xhtml+xml"_s) || equalLettersIgnoringASCIICase(contentType, "application/vnd.hbbtv.xhtml+xml"_s))
         return XMLDocument::createXHTML(frame, settings, url);
     if (equalLettersIgnoringASCIICase(contentType, "text/plain"_s))
         return TextDocument::create(frame, settings, url, documentIdentifier);
diff --git a/Source/WebCore/platform/MIMETypeRegistry.cpp b/Source/WebCore/platform/MIMETypeRegistry.cpp
index 9b54ff20..be7bd352 100644
--- a/Source/WebCore/platform/MIMETypeRegistry.cpp
+++ b/Source/WebCore/platform/MIMETypeRegistry.cpp
@@ -227,6 +227,7 @@ HashSet<String, ASCIICaseInsensitiveHash>& MIMETypeRegistry::supportedNonImageMI
             "text/"_s,
             "application/xml"_s,
             "application/xhtml+xml"_s,
+            "application/vnd.hbbtv.xhtml+xml"_s, // HbbTV applications (ETSI TS 102 796), an XHTML document
 #if !PLATFORM(IOS_FAMILY)
             "application/vnd.wap.xhtml+xml"_s,
             "application/rss+xml"_s,
