From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] Enable the default EGL display fallback for WPE

WebProcess::initializePlatformDisplayIfNeeded() tries GBM, then the Mesa
surfaceless platform, then (GTK/Android only) PlatformDisplayDefault, and
otherwise aborts with 'no supported platform available'. WPE already compiles
PlatformDisplayDefault.cpp (SourcesWPE.txt) but its guards exclude WPE.
On EGL stacks without EGL_MESA_platform_surfaceless or GBM (vendor set-top
box drivers such as Broadcom V3D) plain eglGetDisplay(EGL_DEFAULT_DISPLAY) is
the only working way to get a display, and it supports surfaceless contexts.

---
--- a/Source/WebCore/platform/graphics/egl/PlatformDisplayDefault.h	2026-09-19 16:28:27.699348957 +0200
+++ b/Source/WebCore/platform/graphics/egl/PlatformDisplayDefault.h	2026-09-19 16:28:27.729457994 +0200
@@ -25,7 +25,7 @@
 
 #pragma once
 
-#if PLATFORM(GTK) || OS(ANDROID)
+#if PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
 
 #include "PlatformDisplay.h"
 
@@ -44,4 +44,4 @@
 
 } // namespace WebCore
 
-#endif // PLATFORM(GTK) || OS(ANDROID)
+#endif // PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
--- a/Source/WebCore/platform/graphics/egl/PlatformDisplayDefault.cpp	2026-09-19 16:28:27.699348957 +0200
+++ b/Source/WebCore/platform/graphics/egl/PlatformDisplayDefault.cpp	2026-09-19 16:28:27.729457994 +0200
@@ -26,7 +26,7 @@
 #include "config.h"
 #include "PlatformDisplayDefault.h"
 
-#if PLATFORM(GTK) || OS(ANDROID)
+#if PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
 
 #include "GLContext.h"
 #include <epoxy/egl.h>
@@ -57,4 +57,4 @@
 
 } // namespace WebCore
 
-#endif // PLATFORM(GTK) || OS(ANDROID)
+#endif // PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
--- a/Source/WebKit/WebProcess/glib/WebProcessGLib.cpp	2026-09-19 16:28:27.699348957 +0200
+++ b/Source/WebKit/WebProcess/glib/WebProcessGLib.cpp	2026-09-19 16:28:27.729457994 +0200
@@ -70,7 +70,7 @@
 #include <WebCore/PlatformDisplayAndroid.h>
 #endif
 
-#if PLATFORM(GTK) || OS(ANDROID)
+#if PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
 #include <WebCore/PlatformDisplayDefault.h>
 #endif
 
@@ -174,7 +174,7 @@
         return;
     }
 
-#if PLATFORM(GTK) || OS(ANDROID)
+#if PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
     if (auto display = PlatformDisplayDefault::create()) {
         PlatformDisplay::setSharedDisplay(WTF::move(display));
         return;
