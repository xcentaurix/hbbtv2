From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] WPE: handle PlatformDisplay::Type::Default

Follow-up to enabling PlatformDisplayDefault for WPE: the Type::Default enum
value was GTK/Android only, so define it for WPE too, use the surfaceless GL
target for it (the default display supports surfaceless contexts), and deliver
frames through shared memory (no dma-buf export on such displays).

---
diff --git a/Source/WebCore/platform/graphics/PlatformDisplay.h b/Source/WebCore/platform/graphics/PlatformDisplay.h
index 904b4b70..04352e0c 100644
--- a/Source/WebCore/platform/graphics/PlatformDisplay.h
+++ b/Source/WebCore/platform/graphics/PlatformDisplay.h
@@ -81,7 +81,7 @@ public:
 #if OS(ANDROID)
         Android,
 #endif
-#if PLATFORM(GTK) || OS(ANDROID)
+#if PLATFORM(GTK) || PLATFORM(WPE) || OS(ANDROID)
         Default,
 #endif
     };
diff --git a/Source/WebCore/platform/graphics/egl/GLContext.cpp b/Source/WebCore/platform/graphics/egl/GLContext.cpp
index dc861dc0..a8d6d5d8 100644
--- a/Source/WebCore/platform/graphics/egl/GLContext.cpp
+++ b/Source/WebCore/platform/graphics/egl/GLContext.cpp
@@ -282,6 +282,10 @@ static GLContext::Target targetForPlatformDisplay(PlatformDisplay& platformDispl
     switch (platformDisplay.type()) {
     case PlatformDisplay::Type::Surfaceless:
         return GLContext::Target::Surfaceless;
+#if PLATFORM(WPE) && !OS(ANDROID)
+    case PlatformDisplay::Type::Default:
+        return GLContext::Target::Surfaceless;
+#endif
 #if USE(WPE_RENDERER)
     case PlatformDisplay::Type::WPE:
         return GLContext::Target::WPE;
diff --git a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
index f3daaef2..aaa051a4 100644
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
@@ -606,6 +606,11 @@ AcceleratedSurface::SwapChain::SwapChain(AcceleratedSurface& surface)
         else
             m_type = Type::SharedMemory;
         break;
+#if PLATFORM(WPE) && !OS(ANDROID)
+    case PlatformDisplay::Type::Default:
+        m_type = Type::SharedMemory;
+        break;
+#endif
 #if USE(GBM)
     case PlatformDisplay::Type::GBM:
         if (display.eglExtensions().EXT_image_dma_buf_import) {
