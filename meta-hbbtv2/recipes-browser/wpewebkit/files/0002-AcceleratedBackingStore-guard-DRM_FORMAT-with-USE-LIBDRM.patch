From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] AcceleratedBackingStore: guard DRM_FORMAT_XRGB8888 with USE(LIBDRM)

drm_fourcc.h is only included when USE(LIBDRM) (or on Android), and the
DRM_FORMAT_ARGB8888 use further down is guarded, but the DRM_FORMAT_XRGB8888
use in getImageInfoFromBuffer() was not, so a build with -DUSE_LIBDRM=OFF and
the WPE Platform API fails to compile.

---
--- a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp	2026-09-19 15:04:08.268063639 +0200
+++ b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp	2026-09-19 15:04:08.288139938 +0200
@@ -217,8 +217,12 @@
     if (WPE_IS_BUFFER_DMA_BUF(buffer.get())) {
         auto* dmaBuffer = WPE_BUFFER_DMA_BUF(buffer.get());
         SkAlphaType alphaType = kPremul_SkAlphaType;
+#if USE(LIBDRM)
         if (wpe_buffer_dma_buf_get_format(dmaBuffer) == DRM_FORMAT_XRGB8888)
             alphaType = kOpaque_SkAlphaType;
+#else
+        UNUSED_PARAM(dmaBuffer);
+#endif
         return SkImageInfo::Make(width, height, kBGRA_8888_SkColorType, alphaType, SkColorSpace::MakeSRGB());
     }
 
