From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] GStreamer: Dreambox sinks - decoder position, seek flags and seek completion

Measured with a GStreamer-only probe on a DM900 (dvbvideosink/dvbaudiosink through playbin):
 - position queries on the sinks/pipeline return what has been pushed into the driver (the whole clip a second after
   start) or garbage; the decoder's real position is the sinks' get-decoder-time action signal (what enigma2 uses):
   new GStreamerQuirk::decoderPositionFromSinks() hook.
 - FLUSH | ACCURATE seeks stall the hardware output; FLUSH | KEY_UNIT (as enigma2 does) works, pause/resume too:
   new GStreamerQuirk::adjustSeekFlags() hook.
 - the sinks stay non-async (async=TRUE breaks pause), so a flushing seek never gets GST_MESSAGE_ASYNC_DONE, which is
   what WebKit waits for: new GStreamerQuirk::seekCompletesWithoutAsyncDone() hook, the seek is completed shortly after
   the seek event has been sent.

---
diff --git a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
index c5b86056..3455afc2 100644
--- a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
@@ -622,7 +622,19 @@ bool MediaPlayerPrivateGStreamer::doSeek(const SeekTarget& target, float rate, b
         m_isSegmentSeekAllowed = false;
         flag = GST_SEEK_FLAG_FLUSH;
     }
-    auto seekFlags = static_cast<GstSeekFlags>(flag | GST_SEEK_FLAG_ACCURATE);
+    auto seekFlags = GStreamerQuirksManager::singleton().adjustSeekFlags(static_cast<GstSeekFlags>(flag | GST_SEEK_FLAG_ACCURATE));
+
+    // With sinks that never post ASYNC_DONE, nothing tells us that the flush is over (and updateStates() does not run for a
+    // seek in PLAYING): once the seek event has been sent the seek is as complete as it will get, so complete it.
+    auto completeSeekWithoutAsyncDone = [this, time = target.time] {
+        if (!GStreamerQuirksManager::singleton().seekCompletesWithoutAsyncDone())
+            return;
+        RunLoop::mainSingleton().dispatchAfter(100_ms, [weakThis = ThreadSafeWeakPtr { *this }, time] {
+            RefPtr protectedThis = weakThis.get();
+            if (protectedThis && protectedThis->m_isSeeking && !protectedThis->m_isSeekPending && protectedThis->m_seekTarget.time == time)
+                protectedThis->finishSeek();
+        });
+    };
 
     // Seeking towards the end is not well supported in oggdemux, sometimes it receives EOS
     // while trying to retrieve a chain and thus disables seeking in push mode.
@@ -678,10 +690,13 @@ bool MediaPlayerPrivateGStreamer::doSeek(const SeekTarget& target, float rate, b
             gst_element_send_event(pipeline, gst_event_new_seek(rate, format, flags, startType, start, stopType, stop));
         }), data, reinterpret_cast<GDestroyNotify>(destroyAsyncSeekData));
 
+        completeSeekWithoutAsyncDone();
         return true;
     }
 
     auto result = gst_element_send_event(m_pipeline.get(), event.leakRef());
+    if (result)
+        completeSeekWithoutAsyncDone();
     if (isSegment || !isSeamlessSeekingEnabled() || !result)
         return result;
 
@@ -1686,6 +1701,13 @@ bool MediaPlayerPrivateGStreamer::isMediaStreamPlayer() const
 
 GstClockTime MediaPlayerPrivateGStreamer::gstreamerPositionFromSinks() const
 {
+    // Only with a known duration: the decoder time is garbage before the first frame and the duration is what bounds it.
+    gint64 durationForBound = GST_CLOCK_TIME_NONE;
+    if (m_pipeline && gst_element_query_duration(m_pipeline.get(), GST_FORMAT_TIME, &durationForBound) && GST_CLOCK_TIME_IS_VALID(durationForBound)) {
+        if (auto decoderPosition = GStreamerQuirksManager::singleton().decoderPositionFromSinks(m_audioSink.get(), m_videoSink.get(), static_cast<GstClockTime>(durationForBound) + 5 * GST_SECOND))
+            return *decoderPosition;
+    }
+
     gint64 gstreamerPosition = GST_CLOCK_TIME_NONE;
     // Asking directly to the sinks and choosing the highest value is faster than asking to the pipeline.
     GST_TRACE_OBJECT(pipeline(), "Querying position to audio sink (if any).");
diff --git a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
index 86b45f9e..4f8e1659 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
+++ b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
@@ -19,6 +19,35 @@ GstElement* GStreamerQuirkDreambox::createAudioSink()
     return makeGStreamerElement("dvbaudiosink"_s);
 }
 
+// The hardware decoders cannot drop the frames that lead from a keyframe to an accurate seek target the way a software
+// decoder does: after a FLUSH | ACCURATE seek the output stalled. enigma2's own player (eServiceMP3) seeks to the nearest
+// keyframe with FLUSH | KEY_UNIT, which the sinks handle: the decoder restarts at the keyframe and pause/resume work.
+GstSeekFlags GStreamerQuirkDreambox::adjustSeekFlags(GstSeekFlags flags) const
+{
+    return static_cast<GstSeekFlags>((flags & ~GST_SEEK_FLAG_ACCURATE) | GST_SEEK_FLAG_KEY_UNIT);
+}
+
+// What the sinks report to position queries is what has been pushed into the driver, which for a small clip is the whole
+// stream a second after it started. The real position of the decoder is available as an action signal, and enigma2's
+// own player (eServiceMP3::getPlayPosition) takes it from the audio sink when there is one, from the video sink otherwise.
+std::optional<GstClockTime> GStreamerQuirkDreambox::decoderPositionFromSinks(GstElement* audioSink, GstElement* videoSink, GstClockTime maxPosition) const
+{
+    for (GstElement* sink : { audioSink, videoSink }) {
+        if (!sink || !g_signal_lookup("get-decoder-time", G_OBJECT_TYPE(sink)))
+            continue;
+        // Before the first frame the driver reports garbage (hours, a different value every time: maxPosition, the duration
+        // plus some slack, tells it from a real position); while paused the plain pipeline query is wrong and the decoder
+        // time is frozen at the right value.
+        if (GST_STATE(sink) < GST_STATE_PAUSED)
+            continue;
+        gint64 position = GST_CLOCK_TIME_NONE;
+        g_signal_emit_by_name(sink, "get-decoder-time", &position);
+        if (GST_CLOCK_TIME_IS_VALID(position) && static_cast<GstClockTime>(position) <= maxPosition)
+            return static_cast<GstClockTime>(position);
+    }
+    return std::nullopt;
+}
+
 std::optional<bool> GStreamerQuirkDreambox::isHardwareAccelerated(GstElementFactory* factory)
 {
     auto view = StringView::fromLatin1(GST_OBJECT_NAME(factory));
diff --git a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.h b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.h
index 853a2c53..b460c751 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.h
+++ b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.h
@@ -18,6 +18,9 @@ public:
     bool isPlatformSupported() const final;
 
     GstElement* createAudioSink() final;
+    bool seekCompletesWithoutAsyncDone() const final { return true; }
+    GstSeekFlags adjustSeekFlags(GstSeekFlags) const final;
+    std::optional<GstClockTime> decoderPositionFromSinks(GstElement*, GstElement*, GstClockTime maxPosition) const final;
     std::optional<bool> isHardwareAccelerated(GstElementFactory*) final;
     unsigned getAdditionalPlaybinFlags() const final { return getGstPlayFlag("native-video") | getGstPlayFlag("native-audio"); }
 };
diff --git a/Source/WebCore/platform/gstreamer/GStreamerQuirks.cpp b/Source/WebCore/platform/gstreamer/GStreamerQuirks.cpp
index dbcc34e2..8a212426 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerQuirks.cpp
+++ b/Source/WebCore/platform/gstreamer/GStreamerQuirks.cpp
@@ -416,6 +416,31 @@ void GStreamerQuirksManager::processWebAudioSilentBuffer(GstBuffer* buffer) cons
     }
 }
 
+bool GStreamerQuirksManager::seekCompletesWithoutAsyncDone() const
+{
+    for (const auto& quirk : m_quirks) {
+        if (quirk->seekCompletesWithoutAsyncDone())
+            return true;
+    }
+    return false;
+}
+
+GstSeekFlags GStreamerQuirksManager::adjustSeekFlags(GstSeekFlags flags) const
+{
+    for (const auto& quirk : m_quirks)
+        flags = quirk->adjustSeekFlags(flags);
+    return flags;
+}
+
+std::optional<GstClockTime> GStreamerQuirksManager::decoderPositionFromSinks(GstElement* audioSink, GstElement* videoSink, GstClockTime maxPosition) const
+{
+    for (const auto& quirk : m_quirks) {
+        if (auto position = quirk->decoderPositionFromSinks(audioSink, videoSink, maxPosition))
+            return position;
+    }
+    return std::nullopt;
+}
+
 bool GStreamerQuirksManager::needsCustomInstantRateChange() const
 {
     for (auto& quirk : m_quirks) {
diff --git a/Source/WebCore/platform/gstreamer/GStreamerQuirks.h b/Source/WebCore/platform/gstreamer/GStreamerQuirks.h
index 8a522dee..360e6d13 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerQuirks.h
+++ b/Source/WebCore/platform/gstreamer/GStreamerQuirks.h
@@ -111,6 +111,15 @@ public:
 
     virtual std::optional<GstState> eosMediaPlayerState() const { return { }; }
 
+    // Position of the platform's decoder(s), for sinks that do not answer position queries with what is on screen.
+    // maxPosition: the position cannot be beyond this (the stream's duration plus some slack); values above are garbage.
+    virtual std::optional<GstClockTime> decoderPositionFromSinks(GstElement*, GstElement*, GstClockTime maxPosition) const { UNUSED_PARAM(maxPosition); return std::nullopt; }
+
+    // Sinks that never post GST_MESSAGE_ASYNC_DONE after a flushing seek, which is what WebKit waits for to complete it.
+    virtual bool seekCompletesWithoutAsyncDone() const { return false; }
+    // Platforms whose decoders cannot cope with some seek flags (e.g. hardware decoders and GST_SEEK_FLAG_ACCURATE).
+    virtual GstSeekFlags adjustSeekFlags(GstSeekFlags flags) const { return flags; }
+
 };
 
 class GStreamerHolePunchQuirk : public GStreamerQuirkBase {
@@ -150,6 +159,10 @@ public:
 
     GstState eosMediaPlayerState() const;
 
+    std::optional<GstClockTime> decoderPositionFromSinks(GstElement* audioSink, GstElement* videoSink, GstClockTime maxPosition) const;
+    bool seekCompletesWithoutAsyncDone() const;
+    GstSeekFlags adjustSeekFlags(GstSeekFlags) const;
+
     bool supportsVideoHolePunchRendering() const;
     GstElement* createHolePunchVideoSink(bool isLegacyPlaybin, const MediaPlayer*);
     void setHolePunchVideoRectangle(GstElement*, const IntRect&);
