From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] GStreamer: Dreambox hole punch - the embedder may show the view scaled

HbbTV applications are laid out at 1280x720 and shown scaled to the whole screen. The hole-punch rectangle of a <video> is in
view pixels, so scale it by WPE_DREAM_VIDEO_SCALE before mapping it to the video plane.

---
diff --git a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
index b152b1b1..49d90006 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
+++ b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
@@ -100,6 +100,7 @@ static void writeVideoProc(const char* name, int value)
 bool GStreamerHolePunchQuirkDreambox::setHolePunchVideoRectangle(GstElement*, const IntRect& rect)
 {
     static int originX = 0, originY = 0, screenW = 1920, screenH = 1080;
+    static double scale = 1.0;
     static bool configured = false;
     static IntRect lastRect;
     if (!configured) {
@@ -108,6 +109,11 @@ bool GStreamerHolePunchQuirkDreambox::setHolePunchVideoRectangle(GstElement*, co
             sscanf(origin, "%d,%d", &originX, &originY);
         if (const char* screen = getenv("WPE_DREAM_VIDEO_SCREEN"))
             sscanf(screen, "%dx%d", &screenW, &screenH);
+        if (const char* factor = getenv("WPE_DREAM_VIDEO_SCALE")) {
+            scale = atof(factor);
+            if (scale <= 0)
+                scale = 1.0;
+        }
         if (screenW <= 0 || screenH <= 0) {
             screenW = 1920;
             screenH = 1080;
@@ -117,11 +123,12 @@ bool GStreamerHolePunchQuirkDreambox::setHolePunchVideoRectangle(GstElement*, co
         return true;
     lastRect = rect;
 
-    // view pixels -> screen pixels -> the driver's 720x576 output space (clamped to it)
-    int left = (originX + rect.x()) * 720 / screenW;
-    int top = (originY + rect.y()) * 576 / screenH;
-    int right = (originX + rect.maxX()) * 720 / screenW;
-    int bottom = (originY + rect.maxY()) * 576 / screenH;
+    // view pixels -> screen pixels (the embedder may show the view scaled up, e.g. a 1280x720 page on a 1920x1080 screen) -> the
+    // driver's 720x576 output space (clamped to it)
+    int left = static_cast<int>((originX + rect.x() * scale) * 720 / screenW);
+    int top = static_cast<int>((originY + rect.y() * scale) * 576 / screenH);
+    int right = static_cast<int>((originX + rect.maxX() * scale) * 720 / screenW);
+    int bottom = static_cast<int>((originY + rect.maxY() * scale) * 576 / screenH);
     left = std::clamp(left, 0, 720);
     top = std::clamp(top, 0, 576);
     right = std::clamp(right, left, 720);
diff --git a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
index a896cc18..66cfe5d3 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
+++ b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
@@ -6,6 +6,8 @@
  * The page does not know where it sits on the screen, so the embedder tells it:
  *   WPE_DREAM_VIDEO_ORIGIN=x,y     screen position of the web view's top-left corner (default 0,0)
  *   WPE_DREAM_VIDEO_SCREEN=WxH     size of the screen/OSD the view is placed on (default 1920x1080)
+ *   WPE_DREAM_VIDEO_SCALE=F        the view is shown F times larger than its size (default 1: a 1280x720 page on a
+ *                                  1920x1080 screen is 1.5)
  * Enable with WEBKIT_GST_HOLE_PUNCH_QUIRK=dreambox (plus WEBKIT_GST_QUIRKS=dreambox for the audio sink).
  */
 
