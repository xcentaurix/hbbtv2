+#if ENABLE(WPE_PLATFORM) && USE(SKIA) && OS(LINUX)
+#define ION_PIXMAP_READBACK 1
+
+namespace {
+
+// Fast read-back of a rendered frame on Dreambox (VideoCore V, vendor EGL "libvc5dream"), where glReadPixels runs at ~14 MB/s.
+//
+// The vendor EGL can render into "pixmap" surfaces described by a struct dmegl_pixmap_handle (EGL/dreameglplatform.h): memory the caller
+// provides, as a physical address plus a CPU mapping. Here that memory is an ION allocation from the BMEM heap (what enigma2 uses for its
+// accelerator surfaces). The frame's framebuffer is blitted into the pixmap by the GPU (linear layout, ~10 ms), and the CPU then copies
+// the damaged rectangles out of the mapping. That mapping is uncached, which makes the load instruction matter (glibc memcpy 27 MB/s,
+// NEON vldmia 200 MB/s), hence the assembler loop below. See docs/spike-s1-results.txt of the hbbtv2 repository.
+//
+// Every failure switches the feature off for good and the caller falls back to Skia's readPixels().
+
+struct IonAllocationData {
+    size_t length;
+    size_t alignment;
+    unsigned heapIDMask;
+    unsigned flags;
+    int handle;
+};
+struct IonFileDescriptorData {
+    int handle;
+    int fd;
+};
+struct IonHandleData {
+    int handle;
+};
+struct IonPhysicalData {
+    int handle;
+    unsigned long address;
+    size_t length;
+};
+static constexpr unsigned ionHeapMaskBMEM = 1u << 6; // ION_HEAP_TYPE_CUSTOM (5) + 1, see enigma2 lib/gdi/fb.cpp
+#define WEBKIT_ION_IOC_ALLOC _IOWR('I', 0, IonAllocationData)
+#define WEBKIT_ION_IOC_FREE _IOWR('I', 1, IonHandleData)
+#define WEBKIT_ION_IOC_SHARE _IOWR('I', 4, IonFileDescriptorData)
+#define WEBKIT_ION_IOC_PHYS _IOWR('I', 8, IonPhysicalData)
+
+struct DreamMemoryHandle {
+    unsigned magic; // 0xF1548173
+    unsigned long length;
+    unsigned long offset;
+    int fd;
+    uintptr_t physical;
+    void* address;
+};
+struct DreamPixmapHandle {
+    DreamMemoryHandle memory;
+    unsigned width;
+    unsigned height;
+    unsigned pitch;
+    unsigned format; // drm fourcc; the driver renders R, G, B, A in memory order whatever it says
+};
+static constexpr unsigned dreamPixmapMagic = 0xF1548173U;
+static constexpr unsigned drmFormatABGR8888 = 0x34324241;
+
+class IonPixmapReadback {
+    WTF_MAKE_NONCOPYABLE(IonPixmapReadback);
+public:
+    enum class Mode : uint8_t { Off, On, Verify };
+
+    static Mode mode()
+    {
+        static const Mode mode = [] {
+            const char* value = getenv("WEBKIT_SHM_READBACK_PIXMAP");
+            if (!value || !*value || !strcmp(value, "1"))
+                return Mode::On;
+            if (!strcmp(value, "verify"))
+                return Mode::Verify;
+            return Mode::Off;
+        }();
+        return mode;
+    }
+
+    // Blits the `box` of the frame in `framebuffer` (of the current EGL context) into the pixmap and waits for the GPU. Returns null when
+    // the feature is unavailable. The pixmap rows are then in image order (top row first), bytes R, G, B, A.
+    static IonPixmapReadback* blit(const IntSize& size, unsigned framebuffer, const IntRect& box, bool mirrored, double& milliseconds)
+    {
+        static bool disabled = mode() == Mode::Off;
+        static IonPixmapReadback* instance = nullptr; // deliberately never freed: it goes with the process (EGL is gone by then)
+        if (disabled)
+            return nullptr;
+        if (instance && instance->m_size != size) {
+            delete instance;
+            instance = nullptr;
+        }
+        if (!instance) {
+            instance = create(size);
+            if (!instance) {
+                disabled = true;
+                return nullptr;
+            }
+        }
+        const auto start = MonotonicTime::now();
+        if (!instance->blitBox(framebuffer, box, mirrored)) {
+            disabled = true;
+            delete instance;
+            instance = nullptr;
+            return nullptr;
+        }
+        milliseconds = (MonotonicTime::now() - start).milliseconds();
+        return instance;
+    }
+
+    // Copies `rect` (image coordinates) out of the pixmap into `destination`, a BGRA buffer with rows of `destinationRowBytes`, starting at
+    // the rect's own top left corner.
+    void copy(const IntRect& rect, uint8_t* destination, size_t destinationRowBytes, bool mirrored) const
+    {
+        for (int row = 0; row < rect.height(); ++row) {
+            const int imageRow = rect.y() + row;
+            const int memoryRow = mirrored ? m_size.height() - 1 - imageRow : imageRow;
+            copySwappingRedAndBlue(destination + static_cast<size_t>(row) * destinationRowBytes,
+                static_cast<const uint8_t*>(m_mapping) + static_cast<size_t>(memoryRow) * m_pitch + static_cast<size_t>(rect.x()) * 4, static_cast<size_t>(rect.width()));
+        }
+    }
+
+    ~IonPixmapReadback()
+    {
+        if (m_surface != EGL_NO_SURFACE)
+            eglDestroySurface(m_display, m_surface);
+        if (m_mapping)
+            munmap(m_mapping, m_mappingLength);
+        if (m_fd >= 0)
+            close(m_fd);
+        if (m_ion >= 0)
+            close(m_ion);
+    }
+
+private:
+    IonPixmapReadback(const IntSize& size)
+        : m_size(size)
+    {
+    }
+
+    static IonPixmapReadback* create(const IntSize& size)
+    {
+        auto readback = std::unique_ptr<IonPixmapReadback>(new IonPixmapReadback(size));
+        if (!readback->initialize()) {
+            WTFLogAlways("[shm-readback] pixmap read-back unavailable, using Skia's readPixels()");
+            return nullptr;
+        }
+        WTFLogAlways("[shm-readback] pixmap read-back active (%dx%d, ION BMEM %zu bytes)", size.width(), size.height(), readback->m_mappingLength);
+        return readback.release();
+    }
+
+    bool initialize()
+    {
+        m_display = eglGetCurrentDisplay();
+        EGLContext context = eglGetCurrentContext();
+        if (m_display == EGL_NO_DISPLAY || context == EGL_NO_CONTEXT)
+            return false;
+
+        m_pitch = static_cast<size_t>(m_size.width()) * 4;
+        m_mappingLength = (m_pitch * m_size.height() + 4095) & ~static_cast<size_t>(4095);
+
+        m_ion = open("/dev/ion", O_RDWR | O_CLOEXEC);
+        if (m_ion < 0)
+            return false;
+        IonAllocationData allocation { m_mappingLength, 4096, ionHeapMaskBMEM, 0, 0 };
+        if (ioctl(m_ion, WEBKIT_ION_IOC_ALLOC, &allocation) < 0)
+            return false;
+        IonPhysicalData physical { allocation.handle, 0, 0 };
+        IonFileDescriptorData share { allocation.handle, -1 };
+        const bool ok = ioctl(m_ion, WEBKIT_ION_IOC_PHYS, &physical) >= 0 && ioctl(m_ion, WEBKIT_ION_IOC_SHARE, &share) >= 0;
+        IonHandleData release { allocation.handle };
+        ioctl(m_ion, WEBKIT_ION_IOC_FREE, &release); // the shared file descriptor keeps the buffer alive
+        if (!ok)
+            return false;
+        m_fd = share.fd;
+        m_mapping = mmap(nullptr, m_mappingLength, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, 0);
+        if (m_mapping == MAP_FAILED) {
+            m_mapping = nullptr;
+            return false;
+        }
+
+        // the surface has to match the config of the context it is used with
+        EGLint configID = 0;
+        EGLConfig config = nullptr;
+        EGLint configCount = 0;
+        if (!eglQueryContext(m_display, context, EGL_CONFIG_ID, &configID))
+            return false;
+        const EGLint configAttributes[] = { EGL_CONFIG_ID, configID, EGL_NONE };
+        if (!eglChooseConfig(m_display, configAttributes, &config, 1, &configCount) || !configCount)
+            return false;
+
+        using CreatePlatformPixmapSurface = EGLSurface (*)(EGLDisplay, EGLConfig, void*, const EGLint*);
+        auto createPixmapSurface = reinterpret_cast<CreatePlatformPixmapSurface>(eglGetProcAddress("eglCreatePlatformPixmapSurfaceEXT"));
+        if (!createPixmapSurface)
+            return false;
+        m_handle.memory = { dreamPixmapMagic, m_mappingLength, 0, -1, static_cast<uintptr_t>(physical.address), m_mapping };
+        m_handle.width = m_size.width();
+        m_handle.height = m_size.height();
+        m_handle.pitch = m_pitch;
+        m_handle.format = drmFormatABGR8888;
+        m_surface = createPixmapSurface(m_display, config, &m_handle, nullptr);
+        return m_surface != EGL_NO_SURFACE;
+    }
+
+    bool blitBox(unsigned framebuffer, const IntRect& box, bool mirrored)
+    {
+        EGLContext context = eglGetCurrentContext();
+        EGLSurface previousDraw = eglGetCurrentSurface(EGL_DRAW);
+        EGLSurface previousRead = eglGetCurrentSurface(EGL_READ);
+        if (context == EGL_NO_CONTEXT || !eglMakeCurrent(m_display, m_surface, m_surface, context))
+            return false;
+
+        // The frame's framebuffer row 0 is the top image row unless the frame is painted mirrored. The pixmap's memory rows run the other way
+        // than GL rows (memory row 0 = the top GL row), so blit upside down to get memory rows = framebuffer rows.
+        const int height = m_size.height();
+        const int sourceTop = mirrored ? height - box.maxY() : box.y();
+        const int sourceBottom = mirrored ? height - box.y() : box.maxY();
+        glDisable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+        glBlitFramebuffer(box.x(), sourceTop, box.maxX(), sourceBottom, box.x(), height - sourceTop, box.maxX(), height - sourceBottom, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glFinish();
+        const bool failed = glGetError() != GL_NO_ERROR;
+
+        eglMakeCurrent(m_display, previousDraw, previousRead, context);
+        return !failed;
+    }
+
+    // BGRA out of RGBA in: `pixels` pixels from the uncached mapping.
+    static void copySwappingRedAndBlue(uint8_t* destination, const uint8_t* source, size_t pixels)
+    {
+#if defined(__ARM_NEON) && defined(__arm__)
+        if (const size_t blocks = pixels / 16) {
+            size_t bytes = blocks * 64;
+            uint8_t* d = destination;
+            const uint8_t* s = source;
+            // 64 bytes per round with one vldmia (the fastest load on this memory), red and blue swapped with a halfword rotation of
+            // every pixel (B A R G) of which only the B and R bytes are kept.
+            asm volatile(
+                "vmov.i16 q8, #0x00ff\n"
+                "1:\n"
+                "vldmia %1!, {d0-d7}\n"
+                "vrev32.16 q9, q0\n"
+                "vrev32.16 q10, q1\n"
+                "vrev32.16 q11, q2\n"
+                "vrev32.16 q12, q3\n"
+                "vbit q0, q9, q8\n"
+                "vbit q1, q10, q8\n"
+                "vbit q2, q11, q8\n"
+                "vbit q3, q12, q8\n"
+                "vstmia %0!, {d0-d7}\n"
+                "subs %2, %2, #64\n"
+                "bne 1b\n"
+                : "+r"(d), "+r"(s), "+r"(bytes)
+                :
+                : "d0", "d1", "d2", "d3", "d4", "d5", "d6", "d7", "d16", "d17", "d18", "d19", "d20", "d21", "d22", "d23", "d24", "d25", "cc", "memory");
+            destination = d;
+            source = s;
+            pixels -= blocks * 16;
+        }
+#endif
+        auto* in = reinterpret_cast<const uint32_t*>(source);
+        auto* out = reinterpret_cast<uint32_t*>(destination);
+        for (; pixels; --pixels, ++in, ++out) {
+            const uint32_t value = *in;
+            *out = (value & 0xff00ff00) | ((value & 0x000000ff) << 16) | ((value & 0x00ff0000) >> 16);
+        }
+    }
+
+    IntSize m_size;
+    EGLDisplay m_display { EGL_NO_DISPLAY };
+    EGLSurface m_surface { EGL_NO_SURFACE };
+    int m_ion { -1 };
+    int m_fd { -1 };
+    void* m_mapping { nullptr };
+    size_t m_mappingLength { 0 };
+    size_t m_pitch { 0 };
+    DreamPixmapHandle m_handle { };
+};
+
+} // namespace
