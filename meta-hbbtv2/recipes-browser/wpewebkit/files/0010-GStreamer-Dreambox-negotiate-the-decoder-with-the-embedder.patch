From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] GStreamer: Dreambox quirks negotiate the decoder with the embedder

enigma2 holds the video and audio decoder for the live service, and the dvb sinks open them when they are created. If the
embedder sets WPE_DREAM_HANDOVER (a UNIX socket path), ask it for the decoder before a dvb sink is created and hold the
connection open as a lease that ends when the last sink is destroyed, so that the live service keeps playing until media
really needs the decoder (HbbTV applications run on top of the live picture) and comes back afterwards.

---
diff --git a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
index 91a6675e..b152b1b1 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
+++ b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.cpp
@@ -7,12 +7,84 @@
 #include <algorithm>
 #include <cstdio>
 #include <cstdlib>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <wtf/Lock.h>
+#include <wtf/Locker.h>
 
 namespace WebCore {
 
+static Lock decoderLeaseLock;
+static int decoderLeaseFd WTF_GUARDED_BY_LOCK(decoderLeaseLock) = -1;
+static unsigned decoderLeaseCount WTF_GUARDED_BY_LOCK(decoderLeaseLock) = 0;
+
+bool acquireDreamboxDecoder()
+{
+    const char* path = getenv("WPE_DREAM_HANDOVER");
+    if (!path || !*path)
+        return true; // nothing to negotiate
+
+    Locker locker { decoderLeaseLock };
+    if (decoderLeaseFd >= 0) {
+        decoderLeaseCount++;
+        return true;
+    }
+
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return false;
+    struct sockaddr_un address = { };
+    address.sun_family = AF_UNIX;
+    strncpy(address.sun_path, path, sizeof(address.sun_path) - 1);
+    char request[48];
+    int requestLength = snprintf(request, sizeof(request), "acquire %d\n", static_cast<int>(getpid()));
+    if (connect(fd, reinterpret_cast<struct sockaddr*>(&address), sizeof(address)) < 0 || write(fd, request, requestLength) != requestLength) {
+        close(fd);
+        return false;
+    }
+    // The embedder has to get enigma2 to stop the live service first: give it time, but not forever.
+    struct pollfd pfd = { fd, POLLIN, 0 };
+    char reply[8] = { };
+    if (poll(&pfd, 1, 10000) <= 0 || read(fd, reply, sizeof(reply) - 1) <= 0 || strncmp(reply, "ok", 2)) {
+        GST_WARNING("Dreambox decoder was not granted by the embedder");
+        close(fd);
+        return false;
+    }
+    decoderLeaseFd = fd;
+    decoderLeaseCount = 1;
+    return true;
+}
+
+static void releaseDreamboxDecoder()
+{
+    Locker locker { decoderLeaseLock };
+    if (!decoderLeaseCount || --decoderLeaseCount)
+        return;
+    close(decoderLeaseFd); // the embedder sees the end of the connection and gives the live service back
+    decoderLeaseFd = -1;
+}
+
+GstElement* leaseDreamboxDecoder(GstElement* sink)
+{
+    if (!sink)
+        return nullptr;
+    if (getenv("WPE_DREAM_HANDOVER"))
+        g_object_weak_ref(G_OBJECT(sink), [](gpointer, GObject*) { releaseDreamboxDecoder(); }, nullptr);
+    return sink;
+}
+
 GstElement* GStreamerHolePunchQuirkDreambox::createHolePunchVideoSink(bool, const MediaPlayer*)
 {
-    return makeGStreamerElement("dvbvideosink"_s, "DreamboxVideoSink"_s);
+    if (!acquireDreamboxDecoder())
+        return nullptr;
+    GstElement* sink = makeGStreamerElement("dvbvideosink"_s, "DreamboxVideoSink"_s);
+    if (!sink) {
+        releaseDreamboxDecoder();
+        return nullptr;
+    }
+    return leaseDreamboxDecoder(sink);
 }
 
 static void writeVideoProc(const char* name, int value)
diff --git a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
index 2779ca4e..a896cc18 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
+++ b/Source/WebCore/platform/gstreamer/GStreamerHolePunchQuirkDreambox.h
@@ -17,6 +17,16 @@
 
 namespace WebCore {
 
+// The video and audio decoder are shared with the live service that enigma2 plays, which must not be disturbed until media
+// really needs them. If the embedder set WPE_DREAM_HANDOVER (the path of a UNIX socket) the web process asks it for the
+// decoder before it creates a dvb sink ("acquire\n", answered by "ok\n" once the live service has been stopped) and keeps
+// the connection open as a lease that ends when the last dvb sink is destroyed, whereupon the embedder gives the live service
+// back. Without the variable nothing is negotiated (the embedder has taken care of the decoder). Returns false when the
+// decoder was denied; the caller then falls back to the software sinks.
+bool acquireDreamboxDecoder();
+// Ties the lease to the sink: it is given up when the sink is destroyed.
+GstElement* leaseDreamboxDecoder(GstElement* sink);
+
 class GStreamerHolePunchQuirkDreambox final : public GStreamerHolePunchQuirk {
 public:
     const ASCIILiteral identifier() const final { return "DreamboxHolePunch"_s; }
diff --git a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
index 4f8e1659..c6bf8930 100644
--- a/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
+++ b/Source/WebCore/platform/gstreamer/GStreamerQuirkDreambox.cpp
@@ -4,6 +4,7 @@
 #if USE(GSTREAMER)
 
 #include "GStreamerCommon.h"
+#include "GStreamerHolePunchQuirkDreambox.h"
 
 namespace WebCore {
 
@@ -16,7 +17,13 @@ bool GStreamerQuirkDreambox::isPlatformSupported() const
 
 GstElement* GStreamerQuirkDreambox::createAudioSink()
 {
-    return makeGStreamerElement("dvbaudiosink"_s);
+    // denied (or missing) decoder: nullptr lets playbin pick its own sink, i.e. software audio
+    if (!acquireDreamboxDecoder())
+        return nullptr;
+    GstElement* sink = makeGStreamerElement("dvbaudiosink"_s);
+    if (!sink)
+        return nullptr;
+    return leaseDreamboxDecoder(sink);
 }
 
