From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] GStreamerChecks: only require gl and mpegts when enabled

With ENABLE_VIDEO the gl and mpegts GStreamer components were always added
to the REQUIRED find_package() list, even with USE_GSTREAMER_GL=OFF and
USE_GSTREAMER_MPEGTS=OFF. Only require them when the matching option is on,
so a target without gst-gl (no OpenGL distro feature) can build with video.

---
--- a/Source/cmake/GStreamerChecks.cmake	2026-09-19 13:50:09.576578315 +0200
+++ b/Source/cmake/GStreamerChecks.cmake	2026-09-19 13:50:09.596570234 +0200
@@ -9,7 +9,13 @@
       else ()
           set(GSTREAMER_COMPONENTS app pbutils)
           if (ENABLE_VIDEO)
-              list(APPEND GSTREAMER_COMPONENTS video mpegts tag gl)
+              list(APPEND GSTREAMER_COMPONENTS video tag)
+              if (USE_GSTREAMER_MPEGTS)
+                  list(APPEND GSTREAMER_COMPONENTS mpegts)
+              endif ()
+              if (USE_GSTREAMER_GL)
+                  list(APPEND GSTREAMER_COMPONENTS gl)
+              endif ()
           endif ()
 
           if (ENABLE_WEB_AUDIO)
