From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] WPE: read back only the damaged regions in the shared-memory render target

glReadPixels() from a GPU render target is extremely slow on some set-top-box drivers
(~14 MB/s on Broadcom V3D: ~270 ms for a 1280x720 frame), which caps the shared-memory
transport at ~3.7 fps whatever the content. The swap chain already records per buffer what
changed since that buffer was last filled (SwapChainDamageTracker), so hand that record to the
shared-memory target and read back only those rects. New buffers and full repaints still read
back the whole frame. Debug switches: WEBKIT_SHM_READBACK_LOG=1 (log path/area/time) and
WEBKIT_SHM_READBACK_VERIFY=1 (compare against a full read-back).

---
diff --git a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
index aaa051a4..b2759650 100644
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
@@ -439,21 +439,93 @@ AcceleratedSurface::RenderTargetSHMImage::~RenderTargetSHMImage() = default;
 
 void AcceleratedSurface::RenderTargetSHMImage::didRenderFrame()
 {
-    if (m_surface->useSkia()) {
-        if (!m_skiaSurface)
+    const IntSize size = m_bitmap->size();
+    const unsigned rowBytes = m_bitmap->bytesPerRow();
+    uint8_t* pixels = m_bitmap->mutableSpan().data();
+    const IntRect fullRect { { }, size };
+
+    // Reading a rendered frame back from the GPU can be extremely slow on some set-top-box drivers (about
+    // 14 MB/s with the Broadcom V3D driver), which caps a full-frame read-back at a few frames per second.
+    // The swap chain already records, per buffer, what changed since that buffer was last filled, so fetch
+    // only that. No record (a new buffer, or a full repaint) means the whole frame.
+    Vector<IntRect, 1> rects;
+    bool partial = false;
+#if ENABLE(DAMAGE_TRACKING)
+    if (m_readbackDamage && m_readbackDamage->mode() != Damage::Mode::Full) {
+        partial = true;
+        for (const auto& rect : m_readbackDamage->rectsForPainting()) {
+            auto clipped = intersection(rect, fullRect);
+            if (!clipped.isEmpty())
+                rects.append(clipped);
+        }
+    }
+    m_readbackDamage = std::nullopt;
+#endif
+    if (!partial)
+        rects.append(fullRect);
+
+    static const bool logReadback = getenv("WEBKIT_SHM_READBACK_LOG");
+    static const bool verifyReadback = getenv("WEBKIT_SHM_READBACK_VERIFY");
+
+    // Read one rect of the rendered frame into `base`, a buffer laid out like the shared bitmap.
+    auto readRect = [&](const IntRect& rect, uint8_t* base) {
+        const int width = rect.width();
+        const int height = rect.height();
+        if (m_surface->useSkia()) {
+            if (!m_skiaSurface)
+                return;
+            SkImageInfo info = SkImageInfo::Make(width, height, SkColorType::kBGRA_8888_SkColorType, SkAlphaType::kPremul_SkAlphaType);
+            auto* destination = base + static_cast<size_t>(rect.y()) * rowBytes + static_cast<size_t>(rect.x()) * 4;
+            if (m_surface->usesGL()) {
+                GLContext::ScopedGLContextCurrent scopedCurrent(*PlatformDisplay::sharedDisplay().skiaGLContext());
+                m_skiaSurface->readPixels(info, destination, rowBytes, rect.x(), rect.y());
+            } else
+                m_skiaSurface->readPixels(info, destination, rowBytes, rect.x(), rect.y());
             return;
+        }
 
-        SkImageInfo info = SkImageInfo::Make(m_bitmap->size().width(), m_bitmap->size().height(), SkColorType::kBGRA_8888_SkColorType, SkAlphaType::kPremul_SkAlphaType);
+        if (!rect.x() && width == size.width() && rowBytes == static_cast<unsigned>(width) * 4) {
+            // Full-width band: the rows are contiguous in the bitmap, read straight into it.
+            glReadPixels(0, rect.y(), width, height, GL_BGRA, GL_UNSIGNED_BYTE, base + static_cast<size_t>(rect.y()) * rowBytes);
+            return;
+        }
 
-        if (m_surface->usesGL()) {
-            GLContext::ScopedGLContextCurrent scopedCurrent(*PlatformDisplay::sharedDisplay().skiaGLContext());
-            m_skiaSurface->readPixels(info, m_bitmap->mutableSpan().data(), m_bitmap->bytesPerRow(), 0, 0);
-        } else
-            m_skiaSurface->readPixels(info, m_bitmap->mutableSpan().data(), m_bitmap->bytesPerRow(), 0, 0);
-        return;
+        Vector<uint8_t> scratch(static_cast<size_t>(width) * height * 4);
+        glReadPixels(rect.x(), rect.y(), width, height, GL_BGRA, GL_UNSIGNED_BYTE, scratch.mutableSpan().data());
+        for (int row = 0; row < height; ++row) {
+            memcpy(base + static_cast<size_t>(rect.y() + row) * rowBytes + static_cast<size_t>(rect.x()) * 4,
+                scratch.span().data() + static_cast<size_t>(row) * width * 4, static_cast<size_t>(width) * 4);
+        }
+    };
+
+    const auto startTime = MonotonicTime::now();
+    int64_t pixelsRead = 0;
+    for (const auto& rect : rects) {
+        readRect(rect, pixels);
+        pixelsRead += static_cast<int64_t>(rect.width()) * rect.height();
     }
 
-    glReadPixels(0, 0, m_bitmap->size().width(), m_bitmap->size().height(), GL_BGRA, GL_UNSIGNED_BYTE, m_bitmap->mutableSpan().data());
+    if (logReadback) {
+        const auto totalPixels = static_cast<int64_t>(size.width()) * size.height();
+        WTFLogAlways("[shm-readback] %s: %zu rect(s), %lld px (%.1f%% of the frame), %.1f ms", partial ? "partial" : "full", rects.size(),
+            static_cast<long long>(pixelsRead), 100.0 * pixelsRead / std::max<int64_t>(1, totalPixels), (MonotonicTime::now() - startTime).milliseconds());
+    }
+
+    if (verifyReadback && partial) {
+        // Debug aid: read the whole frame again and compare it with what the partial read-backs left in the bitmap.
+        Vector<uint8_t> reference(static_cast<size_t>(rowBytes) * size.height());
+        readRect(fullRect, reference.mutableSpan().data());
+        size_t badRows = 0;
+        int firstBadRow = -1;
+        for (int row = 0; row < size.height(); ++row) {
+            if (memcmp(pixels + static_cast<size_t>(row) * rowBytes, reference.span().data() + static_cast<size_t>(row) * rowBytes, static_cast<size_t>(size.width()) * 4)) {
+                if (firstBadRow < 0)
+                    firstBadRow = row;
+                ++badRows;
+            }
+        }
+        WTFLogAlways("[shm-readback] verify: %s (%zu of %d rows differ from a full read-back, first at row %d)", badRows ? "MISMATCH" : "ok", badRows, size.height(), firstBadRow);
+    }
 }
 
 std::unique_ptr<AcceleratedSurface::RenderTarget> AcceleratedSurface::RenderTargetTexture::create(AcceleratedSurface& surface, const IntSize& size)
@@ -1161,6 +1233,13 @@ void AcceleratedSurface::didRenderFrame(TargetContents targetContents)
 
     Vector<IntRect, 1> damageRects;
 #if ENABLE(DAMAGE_TRACKING)
+#if PLATFORM(GTK) || ENABLE(WPE_PLATFORM)
+    // Give a shared-memory target the damage accumulated since it was last filled, before didPresent()
+    // resets that record, so its read-back can be limited to what changed. Without a record (new buffer,
+    // or invalid contents) the target reads back the whole frame.
+    if (m_swapChain.type() == SwapChain::Type::SharedMemory && targetContents != TargetContents::Invalid)
+        static_cast<RenderTargetSHMImage&>(*m_target).setReadbackDamage(std::optional<Damage>(m_damageTracker.damageSinceTargetWasLastCurrent(*m_target)));
+#endif
     m_damageTracker.didPresent(*m_target, targetContents);
     damageRects = m_damageTracker.takeFrameDamageRects();
 #else
diff --git a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.h b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.h
index 8066fc3e..cf4ef30d 100644
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.h
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.h
@@ -316,11 +316,19 @@ private:
         RenderTargetSHMImage(AcceleratedSurface&, const WebCore::IntSize&, Ref<WebCore::ShareableBitmap>&&, WebCore::ShareableBitmapHandle&&);
         ~RenderTargetSHMImage();
 
+#if ENABLE(DAMAGE_TRACKING)
+        // What changed since this buffer was last filled; the read-back only has to fetch that.
+        void setReadbackDamage(std::optional<WebCore::Damage>&& damage) { m_readbackDamage = WTF::move(damage); }
+#endif
+
     private:
         bool supportsExplicitSync() const override { return false; }
         void didRenderFrame() override;
 
         const Ref<WebCore::ShareableBitmap> m_bitmap;
+#if ENABLE(DAMAGE_TRACKING)
+        std::optional<WebCore::Damage> m_readbackDamage;
+#endif
     };
 
     class RenderTargetTexture final : public RenderTargetShareableBuffer {
@@ -459,7 +467,15 @@ private:
         }
 
     private:
-        bool needsFineGrainedDamage() const { return m_platformWalksDamageRects || m_damageUsedForCompositing; }
+        bool needsFineGrainedDamage() const
+        {
+#if PLATFORM(GTK) || ENABLE(WPE_PLATFORM)
+            // The shared-memory read-back fetches each damaged rect separately, so keep the rects exact.
+            if (m_swapChain.type() == SwapChain::Type::SharedMemory)
+                return true;
+#endif
+            return m_platformWalksDamageRects || m_damageUsedForCompositing;
+        }
 
         SwapChain& m_swapChain;
         const bool m_platformWalksDamageRects;
