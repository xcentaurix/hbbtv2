From: HbbTV2 experiment <noreply@localhost>
Subject: [PATCH] GLFence: add WEBKIT_DISABLE_GL_FENCE opt-out

Broadcom V3D set-top box drivers advertise EGL 1.5 but crash inside glFlush() after
eglCreateSync(EGL_SYNC_FENCE) (memcpy from a NULL pointer in the platform layer).
Add an environment opt-out so GLFence::isSupported()/create() report no fence support;
callers then use their existing synchronous fallback.

---
diff --git a/Source/WebCore/platform/graphics/egl/GLFence.cpp b/Source/WebCore/platform/graphics/egl/GLFence.cpp
index 06b19965..0db881c8 100644
--- a/Source/WebCore/platform/graphics/egl/GLFence.cpp
+++ b/Source/WebCore/platform/graphics/egl/GLFence.cpp
@@ -33,10 +33,25 @@
 #include <GLES2/gl2.h>
 #endif
 
+#include <cstdlib>
+#include <cstring>
+
 namespace WebCore {
 
 WTF_MAKE_TZONE_ALLOCATED_IMPL(GLFence);
 
+// Some vendor EGL/GLES drivers advertise EGL 1.5 but crash in glFlush() once an EGL fence sync has been
+// created (seen on Broadcom V3D set-top box drivers). Allow opting out; callers already fall back to a
+// synchronous CPU wait (GrSyncCpu::kYes / glFinish) when fences are unsupported.
+static bool fencesDisabledByEnvironment()
+{
+    static const bool disabled = [] {
+        const char* value = getenv("WEBKIT_DISABLE_GL_FENCE");
+        return value && *value && strcmp(value, "0");
+    }();
+    return disabled;
+}
+
 static inline bool eglVersionSupportsFences(const GLDisplay& display)
 {
     return display.checkVersion(1, 5);
@@ -54,6 +69,9 @@ static inline bool glContextSupportsFences(GLContextWrapper* context)
 
 bool GLFence::isSupported(const GLDisplay& display)
 {
+    if (fencesDisabledByEnvironment())
+        return false;
+
     auto* context = GLContextWrapper::currentContext();
     if (!context)
         return false;
@@ -67,6 +85,9 @@ bool GLFence::isSupported(const GLDisplay& display)
 std::unique_ptr<GLFence> GLFence::create(const GLDisplay& display)
 {
 #if HAVE(GL_FENCE)
+    if (fencesDisabledByEnvironment())
+        return nullptr;
+
     auto* context = GLContextWrapper::currentContext();
     if (!context)
         return nullptr;
